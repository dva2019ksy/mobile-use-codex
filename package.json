{
  "name": "mobile-use-codex",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/launch.mjs monitor",
    "test": "node --test server/*.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run lint && npm run format:check && npm test",
    "smoke": "node scripts/smoke.mjs",
    "package": "node scripts/package.mjs",
    "test:codex-tools": "node scripts/verify-codex-tools.mjs"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "@mobilenext/mobile-mcp": "1.0.9",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-html": "8.2.1",
    "globals": "17.13.0",
    "prettier": "3.9.10"
  },
  "description": "Control mobile devices and view their live screens in Codex.",
  "files": [
    "plugin.json",
    "mcp.json",
    ".agents/plugins/marketplace.json",
    "assets",
    "licenses",
    "server",
    "ui",
    "skills",
    "scripts",
    "package-lock.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".editorconfig",
    ".gitignore",
    ".prettierignore",
    ".prettierrc.json",
    "eslint.config.mjs"
  ],
  "author": {
    "name": "dva2019ksy",
    "email": "dva2019ksy@gmail.com",
    "url": "https://github.com/dva2019ksy"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dva2019ksy/mobile-use-codex.git"
  },
  "homepage": "https://github.com/dva2019ksy/mobile-use-codex#readme",
  "bugs": {
    "url": "https://github.com/dva2019ksy/mobile-use-codex/issues"
  }
